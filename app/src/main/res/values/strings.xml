    <string name="rec_format_aac">AAC (M4A): small</string>
    <string name="rec_on_hold">Keep recording on hold</string>
    <string name="rec_on_hold_sub">When off, the recording stops on hold and a new file starts when the call resumes</string>
    <string name="rec_copy_music">Save copies to Music/CallCtrl</string>
    <string name="rec_copy_music_sub">A copy of each new recording in your Music folder, where other apps (and your backups) can see it</string>
    <string name="rec_auto_delete">Delete recordings after</string>
    <string name="rec_auto_never">Never</string>
