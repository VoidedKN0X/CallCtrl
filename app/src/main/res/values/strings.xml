    <!-- Call recording: settings -->
    <string name="call_recording">Call recording</string>
    <string name="call_recording_sub_off">Off. Record calls through Shizuku</string>
    <string name="call_recording_sub_on">On: %1$s</string>
    <string name="rec_not_default">Call recording only works while CallCtrl is your default phone app.</string>
    <string name="rec_shizuku_group">Shizuku</string>
    <string name="rec_shizuku_not_installed">Shizuku isn\'t installed</string>
    <string name="rec_shizuku_not_installed_sub">CallCtrl records calls through Shizuku, a free, open-source app that lets apps use system features without root. Install it, start it, then come back here.</string>
    <string name="rec_shizuku_get">Get Shizuku</string>
    <string name="rec_shizuku_not_running">Shizuku isn\'t running</string>
    <string name="rec_shizuku_not_running_sub">Open Shizuku and tap Start: with Wireless debugging on the phone itself (in Developer options), or with adb from a computer. Start it again after every restart of the phone.</string>
    <string name="rec_shizuku_open">Open Shizuku</string>
    <string name="rec_shizuku_too_old">Shizuku is too old</string>
    <string name="rec_shizuku_too_old_sub">Update Shizuku to version 11 or newer, then come back here.</string>
    <string name="rec_shizuku_permission">Allow CallCtrl in Shizuku</string>
    <string name="rec_shizuku_permission_sub">Shizuku asks whether CallCtrl may use it. CallCtrl only uses it to capture call audio while a call is recorded.</string>
    <string name="rec_shizuku_allow">Allow</string>
    <string name="rec_shizuku_denied">CallCtrl isn\'t allowed in Shizuku</string>
    <string name="rec_shizuku_denied_sub">You chose not to be asked again. Open Shizuku, go to its authorised applications and allow CallCtrl.</string>
    <string name="rec_shizuku_ready">Shizuku is ready</string>
    <string name="rec_shizuku_ready_sub">Shizuku is running and CallCtrl may use it.</string>
    <string name="rec_shizuku_footer">Android doesn\'t let normal apps record calls. While a call is recorded, Shizuku runs a small part of CallCtrl with the rights of Android\'s debugging shell. That part can only capture call audio, never the microphone, and it ends when the recording does.</string>
    <string name="rec_mode">Record calls</string>
    <string name="rec_mode_off">Off</string>
    <string name="rec_mode_ask">Ask each call</string>
    <string name="rec_mode_always">Always</string>
    <string name="rec_mode_unknown">Only numbers not in your contacts</string>
    <string name="rec_mode_selected">Only selected contacts</string>
    <string name="rec_mode_footer">Recording starts when the call is answered, never while it rings, and stops when the call ends or goes on hold. In every mode but Off the call screen has a Record button; tap the red recording bar to stop.</string>
