    <!-- Setup -->
    <string name="setup_default_title">Make CallCtrl your phone app</string>
    <string name="setup_default_body">As your phone app, CallCtrl shows incoming and ongoing calls, the call history and missed calls. Android keeps handling the calls themselves.</string>
    <string name="setup_default_button">Set as phone app</string>
    <string name="setup_default_skip">Not now</string>
    <string name="setup_perm_title">Allow calls, call history and contacts</string>
    <string name="setup_perm_body">CallCtrl needs to make calls, read your call history and contacts, and show call notifications. Nothing leaves the phone.</string>
    <string name="setup_perm_blocked">Some permissions are turned off for CallCtrl. Turn on Phone, Call logs, Contacts and Notifications in the app\'s permissions.</string>
